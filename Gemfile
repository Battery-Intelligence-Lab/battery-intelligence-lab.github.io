source "https://rubygems.org"

# Jekyll 4 is required so that Sass is compiled by Dart Sass (via
# jekyll-sass-converter 3.x / sass-embedded). The classic GitHub Pages build
# pins jekyll-sass-converter 1.5.2 + Ruby Sass 3.7.4, which cannot parse the
# Sass module system (@use, color.adjust) used in styles/scss.
gem "jekyll", "~> 4.4"

# Needed to run `jekyll serve` on Ruby 3.x (webrick left the stdlib in 3.0).
gem "webrick", "~> 1.9"
